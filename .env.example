# Backend Docker image selected by Compose or run-backend.sh.
PI_WEB_BACKEND_IMAGE=pi-web-separated-backend:0.1.0

# Backend port published by Docker.
PI_WEB_BACKEND_PORT=30142

# Require every browser user to log in. Keep this enabled on the server.
PI_WEB_AUTH_ENABLED=1
# Allow visitors to create normal-user accounts from the login page.
PI_WEB_SELF_REGISTRATION_ENABLED=1
PI_WEB_MAX_USERS=500
PI_WEB_SESSION_TTL_HOURS=12
# Use 1 after the public entry point is HTTPS. Plain HTTP must use 0.
PI_WEB_COOKIE_SECURE=0
PI_WEB_COOKIE_PATH=/

# Compatibility identity used only when PI_WEB_AUTH_ENABLED=0.
PI_WEB_FIXED_USER_ID=user1

# Exact Tomcat frontend origins, comma-separated. Do not use * on shared networks.
PI_WEB_CORS_ORIGINS=http://10.10.10.21:18093

# Set to 0 only if you do not want the agent to learn the chart/download syntax.
PI_WEB_RICH_OUTPUT=1

# Set to 0 only if generated artifacts should not be auto-published in chat.
PI_WEB_AUTO_PUBLISH=1

# Optional outbound proxy for model providers.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1

# Optional future RAG retrieval service. These do nothing until a
# knowledge_search extension is installed under runtime/pi-agent/extensions/.
RAG_API_URL=
RAG_API_KEY=
